{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=trauma_platform_identity;Username=trauma_platform;Password=trauma_platform_dev_password;Include Error Detail=true"
  },
  "Jwt": {
    "SigningKey": "trauma-platform-dev-key-minimum-32-chars-required-for-hs256",
    "Issuer": "https://localhost:7001",
    "Audience": "trauma-platform",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:8081"
    ]
  },
  "Features": {
    "RequireEmailVerification": false,
    "RequireMfaForAdmin": true,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  }
}
