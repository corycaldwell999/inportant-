{
  "name": "@trauma-platform/mobile",
  "private": true,
  "version": "1.0.0",
  "description": "React Native / Expo mobile app for trauma-informed platform",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build": "eas build",
    "test": "jest --watch=false",
    "test:watch": "jest --watch",
    "lint": "eslint app --ext .ts,.tsx",
    "lint:fix": "eslint app --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write app",
    "format:check": "prettier --check app"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-status-bar": "~1.1.0",
    "expo-constants": "~14.5.1",
    "expo-font": "~12.0.4",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/stack": "^6.3.0",
    "react-native-screens": "^4.1.0",
    "react-native-safe-area-context": "^4.10.0",
    "@trauma-platform/types": "*",
    "@trauma-platform/validation": "*",
    "@trauma-platform/sdk": "*",
    "@trauma-platform/security": "*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.0",
    "react-test-renderer": "18.2.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "expo": {
    "plugins": [
      "expo-font"
    ]
  }
}
