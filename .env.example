# Shared runtime configuration
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Trauma Informed Platform
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000
IDENTITY_API_KEY=replace-with-secure-key

# PostgreSQL
POSTGRES_DB=tip_db
POSTGRES_USER=tip_user
POSTGRES_PASSWORD=tip_password
POSTGRES_PORT=5432
DATABASE_URL=Host=localhost;Port=5432;Database=tip_db;Username=tip_user;Password=tip_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=identity-api
SENTRY_DSN=

# Security and AI
AI_FEATURES_ENABLED=false
AI_ALLOW_PRIVATE_DATA=false
